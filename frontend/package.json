{
  "name": "chat-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "typecheck": "tsc --noEmit",
    "validate": "yarn typecheck && yarn lint",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test -c ./playwright.configuration.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@tanstack/react-router": "^1.170.40",
    "classnames": "^2.5.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.9",
    "mermaid": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "swr": "^2.5.1",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@anarkisti/biome-config": "^1.0.0",
    "@biomejs/biome": "^2.5.15",
    "@tanstack/router-plugin": "^1.168.41",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5",
    "babel-plugin-react-compiler": "^1.0.0",
    "playwright": "^1",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5",
    "vitest-browser-react": "^2"
  },
  "packageManager": "yarn@4.16.0"
}
