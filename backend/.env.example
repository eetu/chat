PORT=8080
STATIC_DIR=../frontend/dist
CHAT_DB_PATH=chat.db

# Ollama upstream (LAN host running ollama)
OLLAMA_URL=http://localhost:11434
# Optional: lock to a single model and ignore client model selection
# OLLAMA_MODEL=llama3.1

# Optional: ComfyUI base URL used for img2img (Flux Kontext). Unset → image
# mode falls back to Ollama's /v1/images/generations.
# COMFYUI_URL=http://localhost:8188

# Optional: chat-capable model that rewrites image-gen prompts before they
# hit the image generator. Disabled when unset.
# PROMPT_REFINER_MODEL=gemma3:4b

# Optional: whisper.cpp HTTP server (POST /inference). Drives the mic
# button in the composer. When unset, the UI hides the affordance.
# WHISPER_URL=http://localhost:8190

# Optional: piper-tts HTTP server (POST /). Drives the "read aloud"
# affordance on assistant messages. When unset, the UI hides it.
# PIPER_URL=http://localhost:8192

# Optional: default Ollama embedding model used for RAG document
# ingestion + per-prompt retrieval. Users can override per upload via
# the settings dropdown (populated from /api/embedding-models). When
# unset, RAG features are hidden in the UI.
# EMBEDDING_MODEL=nomic-embed-text
# RAG_TOP_K=4

# Optional: web search. Runs in-process (the `daedra` crate) across
# unkeyed backends — no API key, no upstream service to deploy. Off by
# default because searching reaches the internet from THIS host's IP.
# WEB_SEARCH_ENABLED=1
# How many results are injected, and how many of those get their page
# fetched and reduced to article text (the rest contribute a snippet).
# Fetches are sequential, so FETCH_COUNT is also a latency knob.
# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_FETCH_COUNT=3
# Hard cap on one fetched page, enforced while streaming. The DOM built
# from a page costs several times its size — keep this modest when the
# container has a MemoryMax.
# WEB_SEARCH_MAX_PAGE_KB=512
# Rewrites a turn into a standalone search query so follow-ups ("what
# about the second one?") search sensibly. Unset = use the raw turn.
# WEB_SEARCH_QUERY_MODEL=llama3.2
# Allow the Google/Bing/DuckDuckGo HTML-scraping backends. Off by
# default: scraping those breaks their terms of service and collects
# CAPTCHAs. The RSS and public-API backends cover general queries.
# WEB_SEARCH_ALLOW_SCRAPERS=1
# Backends to skip, comma-separated, by daedra's names. Defaults to
# "marginalia", whose public endpoint no longer answers the URL shape
# the crate builds — it hangs for 30s and is retried once, and since
# every backend is awaited before results aggregate, that was a full
# minute on every search. Set to an empty string to exclude nothing.
# WEB_SEARCH_EXCLUDE_BACKENDS=marginalia

# Rate limits. Set to 0 to disable.
# CHAT_RATE_PER_MIN=60
# AUTH_RATE_PER_MIN=20
# IMAGE_GEN_CONCURRENCY=1

# How long to retain conversations
CHAT_TTL_DAYS=30

# 64-byte hex (128 chars). Generate with: openssl rand -hex 64
SESSION_KEY=

# Auth: dev mode for local development.
# When OIDC_* are also set, OIDC takes precedence and dev_auth is ignored.
DEV_AUTH=1

# OIDC (kanidm). When OIDC_ISSUER is set and provider discovery succeeds,
# /auth/login redirects to the provider and dev_auth is bypassed.
# OIDC_ISSUER=https://kanidm.lan/oauth2/openid/chat
# OIDC_CLIENT_ID=chat
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://chat.lan/auth/callback

# Logging
RUST_LOG=info,chat_backend=debug
