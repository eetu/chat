PORT=8080
STATIC_DIR=../frontend/dist
CHAT_DB_PATH=chat.db

# Ollama upstream (LAN host running ollama)
OLLAMA_URL=http://localhost:11434
# Optional: lock to a single model and ignore client model selection
# OLLAMA_MODEL=llama3.1

# How long to retain conversations
CHAT_TTL_DAYS=30

# 64-byte hex (128 chars). Generate with: openssl rand -hex 64
SESSION_KEY=

# Auth: dev mode for local development.
# When OIDC_* are also set, OIDC takes precedence and dev_auth is ignored.
DEV_AUTH=1

# OIDC (kanidm). When OIDC_ISSUER is set and provider discovery succeeds,
# /auth/login redirects to the provider and dev_auth is bypassed.
# OIDC_ISSUER=https://kanidm.lan/oauth2/openid/chat
# OIDC_CLIENT_ID=chat
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://chat.lan/auth/callback

# Logging
RUST_LOG=info,chat_backend=debug
