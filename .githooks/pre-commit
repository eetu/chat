#!/usr/bin/env bash
set -e

ROOT=$(git rev-parse --show-toplevel)
STAGED=$(git diff --cached --name-only --diff-filter=ACM)

if echo "$STAGED" | grep -q "^frontend/"; then
  echo "Running frontend lint + format..."
  (cd "$ROOT/frontend" && yarn lint)
  (cd "$ROOT/frontend" && yarn format)
fi

# Any Rust workspace member (backend, shared, mcp) or the root manifest.
if echo "$STAGED" | grep -qE "^(backend|shared|mcp)/|^Cargo\.(toml|lock)$"; then
  echo "Running rustfmt + clippy on the workspace..."
  (cd "$ROOT" && cargo fmt --all -- --check)
  (cd "$ROOT" && cargo clippy --workspace --all-targets -- -D warnings)
fi
